---
import Layout from '../layouts/Layout.astro';
import FeasibilitySurvey from '../components/FeasibilitySurvey.vue';
---

<Layout title="P4A Feasability Survey">
  <main>
    <div class="container pt-24">
      <div class="max-w-4xl mx-auto">
        <header class="mb-14">
          <h1 class="mb-8 text-4xl text-p4a-bg1 font-bold">Playbook for America – Feasibility Survey</h1>
          <p class="mb-2 leading-relaxed">
            We are Investigating the desirability and viability of the Playbook for America (P4A) web platform.
          </p>
          <p class="mb-2 leading-relaxed">
            The Playbook for America (P4A) exists to bring together ideas and programs that improve government, strengthen democracy, and renew civic life in the United States.
          </p>
          <p class="mb-2 leading-relaxed">
            Organized as a nonpartisan nonprofit, P4A operates an online platform where citizens and government officials can crowdsource, discuss, and rank ideas and programs, with a focus on turning the most promising ones into actionable solutions. Our aim is to elevate the best ideas from all corners of the nation and help move them toward real-world impact.
          </p>
          <p class="mb-2 leading-relaxed">
            Please take a moment to complete the survey. It's anonymous unless you choose to share your email. (Other entries are required.)
          </p>
        </header>

        <section class="mb-14">
          <div class="max-w-2xl mx-auto">
            <FeasibilitySurvey client:load />
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>
