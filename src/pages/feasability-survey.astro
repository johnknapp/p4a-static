---
import Layout from '../layouts/Layout.astro';
import FeasibilitySurvey from '../components/FeasibilitySurvey.vue';
---

<Layout title="P4A Feasability Survey">
  <main>
    <div class="container pt-24">
      <div class="max-w-4xl mx-auto">
        <header class="mb-14">
          <h1 class="mb-3 text-4xl text-p4a-bg1 font-bold">Placeholder text</h1>
          <p class="text-xl max-w-prose text-p4a-bg0 leading-relaxed tracking-wider">
            Placeholder text
          </p>
        </header>

        <section class="mb-14">
          <div class="max-w-2xl mx-auto">
            <FeasibilitySurvey client:load />
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>
