---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Volunteer @ Playbook for America">
  <main>
    <div class="container pt-24">
      <div class="max-w-3xl mx-auto">
        <header class="mb-8 ">
          <h1 class="mb-3 text-4xl text-p4a-bg1 font-bold">Let’s build this together</h1>
          <p class="text-xl max-w-prose text-p4a-bg0 leading-relaxed tracking-wider">
            Playbook for America (P4A) is an independent, nonpartisan nonprofit operating a civic technology platform
            that transforms citizen-driven ideas into structured Playbooks designed for adoption, execution, and measurable public impact.
          </p>
        </header>

        <section class="mb-8">
          <h2 class="text-2xl text-p4a-bg1 font-bold mb-2">We need your help</h2>
          <p class="mb-2 leading-relaxed">
            Building a better country shouldn’t be left to politicians alone. 
            Playbook for America brings together people who want to contribute ideas, expertise, and energy to improve how our nation works.
          </p>
          <p class="mb-2 leading-relaxed">
            We’re building a structured process that turns citizen ideas into <span class="font-semibold">implementable civic Playbooks 
            that governments and organizations can adopt</span>.
          </p>
          <p class="mb-2 leading-relaxed">
            We’re assembling volunteers to help build P4A, expand outreach, and help define the platform — across areas like 
            research, strategy, writing, community engagement, technology, and execution.
          </p>
          <p class="mb-2 leading-relaxed">
            Tell us a little about yourself and we’ll follow up with ways you can contribute.
          </p>
        </section>
        
        <div class="mb-14 text-center">
          <a
            href="/volunteer-inquiry"
            class="inline-flex items-center justify-center gap-2 bg-p4a-bg1 hover:bg-p4a-bg3 text-white font-bold py-3 px-12 rounded-md transition-colors"
          >
            Get involved <Icon class="text-xl" name="ph:arrow-right" />
          </a>
          <p class="text-sm text-p4a-bg4">1 minute survey</p>
        </div>

        <!-- <section class="mb-14">
          <h2 class="text-3xl text-p4a-bg1 font-bold mb-2">Why you’ll love to be involved</h2>
          <p class="mb-2 leading-relaxed">
            placaeholder
          </p>
        </section> -->

        <!-- <section class="mb-14">
          <h2 class="text-3xl text-p4a-bg1 font-bold mb-2">Who we’re looking for</h2>
          <p class="mb-2 leading-relaxed">
            placaeholder
          </p>  
        </section> -->



      </div>
  </main>
</Layout>
