---
import Layout from '../layouts/Layout.astro';
import ReportIntake from '../components/ReportIntake.vue';
---

<Layout title="File a report – Playbook for America">
  <main>
    <div class="container pt-24">

      <div class="max-w-3xl mx-auto">
        <header class="mb-8">
          <h1 class="mb-3 text-4xl text-p4a-bg1 font-bold">Seen civic injustice, let us deal with it</h1>
          <p class="text-xl max-w-prose text-p4a-bg0 leading-relaxed tracking-wider">
            Seen a problem, something unfair, harmful, broken, or unjust in public life? Report it here without needing a polished writeup or an account.
          </p>
        </header>

        <p class="mb-2 leading-relaxed">
          <span class="text-p4a-bg2 font-bold">Anonymous by default</span><br />
          You do not need to sign up to submit a report.
        </p>
        
        <p class="mb-2 leading-relaxed">
          <span class="text-p4a-bg2 font-bold">Not for emergencies</span><br />
          Do not use this form for emergencies, crimes in progress, or urgent safety situations.
        </p>
        
        <p class="mb-12 leading-relaxed">
          <span class="text-p4a-bg2 font-bold">Reviewed then handed off to the P4A community</span><br />
          All reports are carefully reviewed by our staff before being published.
          Once published, our community can take action to suggest solutions which may become Playbooks for real civic impact.
        </p>

        <section class="mb-14">
          <div class="max-w-2xl mx-auto">
            <ReportIntake client:load />
          </div>
        </section>
      </div>

    </div>
  </main>
</Layout>
