---
import Layout from '../layouts/Layout.astro';
import ReportIntake from '../components/ReportIntake.vue';
---

<Layout title="File a report – Playbook for America">
  <main>
    <div class="container pt-24">

      <div class="max-w-3xl mx-auto">
        <header class="mb-8">
          <h1 class="mb-3 text-4xl text-p4a-bg1 font-bold">File a report</h1>
          <p class="text-xl max-w-prose text-p4a-bg0 leading-relaxed tracking-wider">
            <!-- Describe a civic problem, add any helpful context, and submit it for review. You may report anonymously. 
            Strong reports may later advance into Issues, ideas, and actionable Playbooks. -->
            Seen something unfair, harmful, broken, or unjust in public life? You can report it here without needing a polished writeup or an account.
          </p>
        </header>

        <p class="mb-2 leading-relaxed">
          <span class="font-bold">Anonymous by default</span><br />
          You do not need an account to submit a report.
        </p>
        
        <p class="mb-2 leading-relaxed">
          <span class="font-bold">Not for emergencies</span><br />
          Do not use this form for emergencies, crimes in progress, or urgent safety situations.
        </p>
        
        <p class="mb-12 leading-relaxed">
          <span class="font-bold">Reviewed before broader visibility</span><br />
          Reports are evaluated before they influence broader escalation.
        </p>

        <section class="mb-14">
          <div class="max-w-2xl mx-auto">
            <ReportIntake client:load />
          </div>
        </section>
      </div>

    </div>
  </main>
</Layout>
