---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import amanda from '../assets/amanda_300x.png';
import chris from '../assets/chris_300x.png';
import drew from '../assets/drew_300x.png';
import jk from '../assets/jk_300x.png';
import kimberly from '../assets/kimberly_300x.png';
import snigdha from '../assets/snigdha_300x.png';
---

<Layout title="P4A Volunteer Staff">
  <main>
    
    <div class="container pt-24">

      <div class="max-w-3xl mx-auto">
        <header class="mb-14">
          <h1 class="mb-3 text-4xl text-p4a-ink font-bold">Volunteer staff</h1>
          <p class="text-xl max-w-prose leading-relaxed tracking-wider">
            Meet the passionate people volunteering their time, talent, and energy to help Playbook for America grow, 
            reach more citizens, and turn more good ideas into meaningful civic impact.
          </p>
        </header>
      </div>

      <div class="max-w-3xl mx-auto space-y-8">

        <div class="flex items-center gap-4">
          <div class="w-44 shrink-0">
            <Image class="w-40 h-40 object-cover rounded-full mx-auto" src={amanda} alt="Amanda Forte" />
          </div>
          <div>
            <h3 class="font-bold text-lg">Amanda Forte, Civic Outreach and Growth</h3>
            <div class="mt-2 text-sm">
              Amanda brings research, advocacy, and community engagement experience to P4A, helping us reach civic-minded audiences, grow awareness, and build outreach that feels human, inclusive, and useful.
              <p class="mt-1">
                <a class="text-body-text underline hover:text-link hover:underline underline-offset-4 hover:decoration-4 hover:decoration-accent" href="https://www.linkedin.com/in/amanda-forte-as44777" target="_blank">LinkedIn Profile</a>
              </p>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="w-44 shrink-0">
            <Image class="w-40 h-40 object-cover rounded-full mx-auto" src={chris} alt="Chris Riley" />
          </div>
          <div>
            <h3 class="font-bold text-lg">Chris Riley, Product Management, Advisor</h3>
            <div class="mt-2 text-sm">
              Chris brings product management, systems thinking, and customer insight to P4A, helping shape a platform experience that makes it easier for people to share civic problems, develop practical ideas, and move toward action.
              <p class="mt-1">
                <a class="text-body-text underline hover:text-link hover:underline underline-offset-4 hover:decoration-4 hover:decoration-accent" href="https://www.linkedin.com/in/chrisriley0506/" target="_blank">LinkedIn Profile</a>
              </p>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="w-44 shrink-0">
            <Image class="w-40 h-40 object-cover rounded-full mx-auto" src={drew} alt="Drew Woods" />
          </div>
          <div>
            <h3 class="font-bold text-lg">Drew Woods, Civic Outreach and Growth</h3>
            <div class="mt-2 text-sm">
               Drew brings behavioral science, strategic operations, and growth expertise to P4A, helping us connect with civic organizations, build thoughtful partnerships, and turn human insight into stronger community engagement.
              <p class="mt-1">
                <a class="text-body-text underline hover:text-link hover:underline underline-offset-4 hover:decoration-4 hover:decoration-accent" href="https://www.linkedin.com/in/drew-woods-0b76123a4/" target="_blank">LinkedIn Profile</a>
              </p>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="w-44 shrink-0">
            <Image class="w-40 h-40 object-cover rounded-full mx-auto" src={jk} alt="John Knapp" />
          </div>
          <div>
            <h3 class="font-bold text-lg">John Knapp, Founder, Leadership, Engineering</h3>
            <div class="mt-2 text-sm">
              John conceived and built Playbook for America to make civic participation easier, more practical, and more impactful. He brings the platform’s strategy, systems design, and product architecture together to turn civic problems and public ideas into action-ready Playbooks.
              <p class="mt-1">
                <a class="text-body-text underline hover:text-link hover:underline underline-offset-4 hover:decoration-4 hover:decoration-accent" href="https://www.linkedin.com/in/jknapp/" target="_blank">LinkedIn Profile</a>
              </p>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="w-44 shrink-0">
            <Image class="w-40 h-40 object-cover rounded-full mx-auto" src={kimberly} alt="Kimberly Cook" />
          </div>
          <div>
            <h3 class="font-bold text-lg">Kimberly Cook, Operations, Playbook Workflow and Design</h3>
            <div class="mt-2 text-sm">
              Kimberly brings operations, workflow, and program support experience to P4A, helping us design clearer internal systems, stronger handoffs, and reliable processes that support Playbook development as the platform grows.
              <p class="mt-1">
                <a class="text-body-text underline hover:text-link hover:underline underline-offset-4 hover:decoration-4 hover:decoration-accent" href="https://www.linkedin.com/in/kimberlycook65/" target="_blank">LinkedIn Profile</a>
              </p>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="w-44 shrink-0">
            <Image class="w-40 h-40 object-cover rounded-full mx-auto" src={snigdha} alt="Snigdha Behara" />
          </div>
          <div>
            <h3 class="font-bold text-lg">Snigdha Behara, Product and market research</h3>
            <div class="mt-2 text-sm">
              Snigdha brings UX, product, and market research experience to P4A, helping us better understand civic engagement behaviors, user needs, and growth opportunities through real human insight.
              <p class="mt-1">
                <a class="text-body-text underline hover:text-link hover:underline underline-offset-4 hover:decoration-4 hover:decoration-accent" href="https://www.linkedin.com/in/snigbehara/" target="_blank">LinkedIn Profile</a>
              </p>
            </div>
          </div>
        </div>

      </div>
      
    </div>
  </main>
</Layout>
