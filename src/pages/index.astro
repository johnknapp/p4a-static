---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components'
---

<Layout title="The Playbook for America">

  <main>

    <header class="bg-p4a-bg0 mb-18 drop-shadow-xl">
      <div class="container py-16 md:py-12 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h1 class="text-6xl text-p4a-bg4 font-bold leading-18">
            Connecting people to ideas — and ideas to <span class="text-white ">real results</span>.
          </h1>
        </div>
        <div class="flex flex-col gap-6">
          <h2 class="text-2xl text-white font-semibold leading-15 tracking-wide">
            A nonpartisan platform to shape crowdsourced ideas into structured proposals, ready for people and institutions to deliver real results.
          </h2>
          <div class="text-center">
            <a
              href="https://airtable.com/appH0YK3BFKCCfUVB/pagERE8ylQTG39EZN/form"
              target="_blank"
              class="inline-block"
            >
              <button class="flex items-center justify-center gap-2 bg-p4a-bg3 hover:bg-p4a-bg4 hover:text-p4a-bg0 text-white border border-p4a-body font-bold px-36 py-4 rounded-lg shadow-lg">
                Share your perspective <Icon class="text-2xl" name="ph:arrow-right" />
              </button>
            </a>
            <p class="text-sm text-gray-300 mt-1">4-minute anonymous survey · All viewpoints encouraged</p>
          </div>
        </div>
      </div>
    </header>

    <div class="container pb-16">

      <section class="mb-10">
        <h2 class="text-3xl text-p4a-bg1 font-bold mb-4">How it works</h2>
        <p class="leading-relaxed">
          Coming soon.
        </p>
      </section>

      <section class="mb-10">
        <h2 class="text-3xl text-p4a-bg1 font-bold mb-4">Why it matters</h2>
        <p class="leading-relaxed">
          Coming soon.
        </p>
      </section>

      <section class="mb-10">
        <h2 class="text-3xl text-p4a-bg1 font-bold mb-4">Get involved</h2>
        <p class="leading-relaxed">
          Coming soon.
        </p>
      </section>

    </div>
    
  </main>

</Layout>