---
import Layout from '../layouts/Layout.astro';
import VolunteerInquiryForm from '../components/VolunteerInquiryForm.vue';
---

<Layout title="P4A Volunteer Inquiry">
  <main>
    <div class="container pt-24">
      <div class="max-w-4xl mx-auto">
        <header class="mb-14">
          <h1 class="mb-3 text-4xl text-p4a-bg1 font-bold">Let’s do this!</h1>
          <p class="text-xl max-w-prose text-p4a-bg0 leading-relaxed tracking-wider">
            Tell us about yourself and we’ll get you involved.
          </p>
        </header>

        <section class="mb-14">
          <div class="max-w-2xl mx-auto">
            <VolunteerInquiryForm client:load />
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>
