---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Playbook for America">
  
  <main class="max-w-4xl mx-auto px-6 pt-24 pb-16">

    <header class="mb-12">
      <h1 class="text-5xl text-p4a-bg1 font-bold">Playbook for America</h1>
      <p class="text-2xl font-semibold">
        Connecting people to ideas — and ideas to real results.
      </p>
      <p>
        A nonpartisan platform to surface promising solutions, encourage participation, and help move good ideas toward real-world impact.
      </p>
    </header>

  </main>

</Layout>