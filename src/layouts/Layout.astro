---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;600;700;800&family=Libertinus+Serif:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-p4a-body0 text-black font-sans min-h-screen">
    <header class="bg-p4a-bg0 text-white">
      <div class="container h-18 flex items-center justify-between">
        <div class="font-semibold"><a href="/">The Playbook for America</a></div>
        <nav class="flex gap-8">
          <a href="/" class="hover:underline">Home</a>
          <a href="/about" class="hover:underline">About</a>
        </nav>
      </div>
    </header>
    <slot />
  </body>
</html>
