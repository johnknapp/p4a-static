---
import '../styles/global.css';
import '@formkit/themes/genesis';
import '@formkit/addons/css/multistep';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;600;700;800&family=Libertinus+Serif:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PXYGWT06LV"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-PXYGWT06LV');
    </script>

  </head>
  <body class="bg-p4a-body0 text-black font-sans min-h-screen flex flex-col">
    <header class="bg-p4a-bg0 text-white">
      <div class="container h-18 flex items-center justify-between">
        <div class="md:text-lg font-semibold"><a href="/" class="hover:underline hover:decoration-2">The Playbook for America</a></div>
        <nav class="flex gap-8">
          <a href="/" class="text-sm md:text-base hover:underline hover:decoration-2 hover:decoration-white">Home</a>
          <a href="/file-a-report" class="text-sm md:text-base hover:underline hover:decoration-2 hover:decoration-white">Report</a>
          <a href="/focus-areas" class="text-sm md:text-base hover:underline hover:decoration-2 hover:decoration-white">Focus areas</a>
          <a href="/about" class="text-sm md:text-base hover:underline hover:decoration-2 hover:decoration-white">About</a>
          <a href="/volunteer" class="text-sm md:text-base hover:underline hover:decoration-2 hover:decoration-white">Volunteer</a>
          <a href="/feasability-survey" class="text-sm md:text-base hover:underline hover:decoration-2 hover:decoration-white">Feedback</a>
        </nav>
      </div>
    </header>
    <div class="flex-grow">
      <slot />
    </div>
		<footer class="w-full mt-12 py-6 bg-p4a-bg flex items-center">
			<p class="text-white mx-auto">&copy; The Playbook for America</p>
		</footer>	
  </body>
</html>
