---
import { Icon } from 'astro-icon/components'
---

<div class="text-center">
  <a
    href="/feedback"
    class="inline-block"
  >
    <button class="flex items-center justify-center gap-2 bg-p4a-bg3 hover:bg-p4a-bg4 hover:text-p4a-bg0 text-p4a-body0 font-bold px-12 md:px-18 lg:px-30 py-4 rounded-lg shadow-lg">
      Share your perspective <Icon class="text-2xl" name="ph:arrow-right" />
    </button>
  </a>
  <p class="text-xs md:text-sm text-gray-300 mt-1">2-minute anonymous survey · All viewpoints encouraged</p>
</div>
