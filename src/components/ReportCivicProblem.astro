---
import { Icon } from 'astro-icon/components'
---

<div class="text-center">
  <a
    href="/file-a-report"
    class="block w-full"
  >
    <button class="text-lg flex items-center justify-center gap-2 w-full bg-p4a-bg3 hover:bg-p4a-bg4 hover:text-p4a-bg0 text-p4a-body0 font-bold px-12 md:px-8 lg:px-12 py-4 rounded-lg shadow-lg">
      Report a civic problem deserving real action<Icon class="text-3xl" name="ph:arrow-right" />
    </button>
  </a>
  <p class="text-sm md:text-base text-gray-300 mt-1">
    A problem report is the first step to fixing it. 
    Anonymous by default.
  </p>
</div>
